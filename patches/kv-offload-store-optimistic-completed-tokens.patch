+                # decision itself never assumes content that doesn't exist
+                # yet -- including a request's very first chunk, whose
+                # first-ever scheduling step this branch previously treated
+                # identically to every later, already-warm step.
+                num_tokens_after_batch = req.num_computed_tokens
 
             num_offloadable_tokens = self._calc_num_offloadable_tokens(
                 req_status, num_tokens_after_batch
