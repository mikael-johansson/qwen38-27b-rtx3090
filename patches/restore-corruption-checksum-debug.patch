+def _row_crc32(tensor: torch.Tensor, row_idx: int, unpadded_bytes: int) -> tuple[int, int]:
+    """CRC32 + byte length of one CPU tensor row (a single (layer, chunk) page).
+
+    Truncated to unpadded_bytes: the CPU tensor's row stride is sized to the
+    *padded* page_size_bytes (CanonicalKVCacheTensor.page_size_bytes), but
+    only the first data_ref.page_size_bytes (unpadded) are real data -- the
+    same convention compute_sub_block_ptrs's all_sizes[...] already uses for
+    the copy itself. Without truncating, this would never match the GPU
+    tensor's natural (unpadded) per-block stride in mamba_utils.py's
+    RESTORE_READ, regardless of correctness.
+    """
+    row = tensor[row_idx, :unpadded_bytes]
+    data = row.numpy().tobytes()
+    return zlib.crc32(data), len(data)
+
+
