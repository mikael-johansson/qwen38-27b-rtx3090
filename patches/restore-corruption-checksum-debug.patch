+    """Phase C instrument: hash the mamba state block a cold-resumed request
+    (offload restore OR ordinary local prefix-cache-hit new turn) is about
+    to read its running state from. See module docstring note above."""
+    for gid in mamba_group_ids:
+        block_ids = req_state.block_ids[gid]
+        if prev_state_idx >= len(block_ids):
+            continue
+        block_id = block_ids[prev_state_idx]
+        layer_names = kv_cache_config.kv_cache_groups[gid].layer_names
+        for layer_idx, layer_name in enumerate(layer_names):
+            attention = forward_context.get(layer_name)
+            if attention is None:
+                continue
+            kv_caches: list[torch.Tensor] = attention.kv_cache
+            # v1/kv_offload's register_kv_caches() (worker.py, MambaSpec
+            # branch) offloads ONE combined per-layer page
+            # (kv_caches[layer_name].view(num_blocks, page_size_bytes)),
+            # not one page per state type -- conv_state and temporal/ssm
+            # state are views into that same physical storage. Concatenate
+            # them here in the same (state_type) order so this hash is
+            # over the identical byte range gpu_worker.py's STORE_DONE /
+            # LOAD_SUBMIT hash covers per (layer, gpu_blk); hashing each
+            # state type separately would never match those by
+            # construction, regardless of correctness.
+            chunks = []
