+def _concurrency_during(engine_client) -> int | None:
+    """Other requests in flight once this request is itself mid-stream —
+    called from inside the ``async for res in result_generator`` loop,
+    where receiving any `res` at all proves this request is already
+    registered, so the raw count includes it. Subtract 1 to get "other".
+    """
+    n = _num_unfinished_requests(engine_client)
+    return None if n is None else max(n - 1, 0)
