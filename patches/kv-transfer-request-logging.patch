@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Readable per-request logging for KV block movement between tiers.
+
+The offloading connector already emits a lot of DEBUG detail, but it is
+written for tracing one mechanism at a time: chunk indices, job ids, per-group
+skip decisions. None of it answers the question you actually have while
+watching a live server -- *did this request's context come off the disk, and
+how much of it moved?*
+
+This module emits one INFO line per transfer, interspersed in the normal log:
+
+    KV LOAD  chatcmpl-a9b273614cd4c815 | fs   -> RAM  |  44 blk
+    KV LOAD  chatcmpl-a9b273614cd4c815 | RAM  -> VRAM |  44 blk /  36608 tok (GPU had 50752 tok)
+    KV STORE chatcmpl-b88083b7827488ae | VRAM -> RAM  |  12 blk /   9984 tok
+    KV STORE chatcmpl-b88083b7827488ae | RAM  -> fs   |  12 blk
+
+A full disk-backed resume therefore reads top to bottom as
+``fs -> RAM`` then ``RAM -> VRAM``, which is the staged promotion the tiering
+manager actually performs (secondary tiers cannot touch GPU memory directly).
+
+Set VLLM_KV_TRANSFER_LOG=0 to silence it. It is deliberately INFO and on by
+default: the whole point is to be visible next to the request log without
+turning on DEBUG for all of vLLM, which buries it.
+"""
+
+import os
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# Read once at import. This is a deployment-level switch, not something that
+# should be re-checked in a per-block hot path.
+_ENABLED = os.environ.get("VLLM_KV_TRANSFER_LOG", "1") != "0"
+
+# Request ids are long ("chatcmpl-<32 hex>-<8 hex>" once the connector appends
+# its own suffix). Keep the head, which is what appears in the request log
+# filenames and in the API response, so lines can be grepped against those.
+_REQ_ID_MAX = 34
+
+
+def kv_transfer_log_enabled() -> bool:
+    return _ENABLED
+
+
+def _short_req_id(req_id: str) -> str:
+    if len(req_id) <= _REQ_ID_MAX:
+        return req_id
+    return req_id[:_REQ_ID_MAX] + "…"
+
+
+def log_kv_transfer(
+    action: str,
+    req_id: str,
+    src: str,
+    dst: str,
+    num_blocks: int,
+    num_tokens: int | None = None,
+    note: str = "",
+) -> None:
+    """Emit one readable transfer line.
+
+    Args:
+        action: "LOAD", "STORE" or "EVICT".
+        req_id: Owning request. Evictions may not have one; pass "-".
+        src, dst: Tier labels -- "VRAM", "RAM", or a secondary tier_type ("fs").
+        num_blocks: Blocks moved.
+        num_tokens: Tokens, when the caller knows the block size.
+        note: Optional trailing context, e.g. "GPU had 50752 tok".
+    """
+    if not _ENABLED or num_blocks <= 0:
+        return
+    if num_tokens is None:
+        size = f"{num_blocks:3d} blk"
+    else:
+        size = f"{num_blocks:3d} blk / {num_tokens:6d} tok"
+    logger.info(
+        "KV %-5s %s | %-4s -> %-4s | %s%s",
+        action,
+        _short_req_id(req_id),
+        src,
+        dst,
+        size,
+        f" ({note})" if note else "",
+    )
