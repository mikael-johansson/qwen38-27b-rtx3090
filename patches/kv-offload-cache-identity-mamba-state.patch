+    # A group that is not an AttentionSpec carries recurrent (Mamba/GDN) state,
+    # whose on-disk bytes depend on mamba_ssm_cache_dtype / mamba_cache_mode.
+    # Models without such groups keep their existing cache identity untouched.
+    has_recurrent_groups = any(
+        not isinstance(group.kv_cache_spec, AttentionSpec)
+        for group in kv_cache_config.kv_cache_groups
+    )
+
     _, tokens_per_hash = resolve_kv_cache_block_sizes(kv_cache_config, vllm_config)
     for group in groups:
         assert group.tokens_per_block % tokens_per_hash == 0, (
@@ -167,6 +175,16 @@ def build_offloading_config(
         cache=OffloadingCacheConfig(
             tokens_per_hash=tokens_per_hash,
             blocks_per_chunk=blocks_per_chunk,
+            mamba_ssm_cache_dtype=(
+                str(vllm_config.cache_config.mamba_ssm_cache_dtype)
+                if has_recurrent_groups
+                else ""
+            ),
+            mamba_cache_mode=(
+                str(vllm_config.cache_config.mamba_cache_mode)
+                if has_recurrent_groups
+                else ""
+            ),
