+def _format_iteration_clause(
+    label: str, req_ids: list[str], total_tokens: int, tok_s: float | None
+) -> str:
+    """One clause of an --enable-logging-iteration-details line, e.g.
+    "prompt processing [chatcmpl-a1b2, chatcmpl-c3d4] (2 reqs, 4096 tokens)
+    = 3792.3 tok/s" (REQUEST_LOGGING_SPEC.md Part 5 "Reformatted line").
+    Token count is always the group's total, never a per-request "N*M"
+    shorthand — a non-uniform batch (different requests scheduled different
+    token counts, e.g. mixed chunked-prefill continuations) would make that
+    shorthand actively misleading, and the total is correct either way.
+    """
+    n = len(req_ids)
+    req_word = "req" if n == 1 else "reqs"
+    rate = f" = {tok_s:.1f} tok/s" if tok_s is not None else ""
+    return f"{label} [{', '.join(req_ids)}] ({n} {req_word}, {total_tokens} tokens){rate}"
+
