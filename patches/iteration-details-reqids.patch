+def _format_iteration_clause(
+    label: str,
+    req_ids: list[str],
+    total_tokens: int,
+    tok_s: float | None,
+    *,
+    accepted_tokens: int | None = None,
+) -> str:
+    """One clause of an --enable-logging-iteration-details line, e.g.
+    "prompt processing [chatcmpl-a1b2, chatcmpl-c3d4] (2 reqs, 4096 tokens)
+    = 3792.3 tok/s" (REQUEST_LOGGING_SPEC.md Part 5 "Reformatted line").
+    Token count is always the group's total, never a per-request "N*M"
+    shorthand — a non-uniform batch (different requests scheduled different
+    token counts, e.g. mixed chunked-prefill continuations) would make that
+    shorthand actively misleading, and the total is correct either way.
+
+    accepted_tokens (generation clause only, when speculative decoding is
+    active): total_tokens alone is the verified count (k+1 per request,
+    fixed by num_speculative_tokens regardless of acceptance) — showing it
+    bare reads as real output and isn't. When accepted_tokens is available,
+    the token count renders as "N verified, M accepted" instead (accepted
+    is always <= verified, unlike a raw "drafted" count which excludes the
+    always-produced bonus token and can read backwards), and tok_s (passed
+    in already computed from accepted tokens) means what it looks like it
+    means.
+    """
+    n = len(req_ids)
+    req_word = "req" if n == 1 else "reqs"
+    rate = f" = {tok_s:.1f} tok/s" if tok_s is not None else ""
+    if accepted_tokens is not None:
+        token_desc = f"{total_tokens} verified, {accepted_tokens} accepted"
+    else:
+        token_desc = f"{total_tokens} tokens"
+    return f"{label} [{', '.join(req_ids)}] ({n} {req_word}, {token_desc}){rate}"
+
+
 class StatLoggerBase(ABC):
     """Interface for logging metrics.
 
