+# workload; 0 disables the skip entirely (falls back to retrying every
+# tick, i.e. today's upstream behavior).
+_HIT_DIVERGED_RETRY_COOLDOWN_S = float(
+    os.environ.get("VLLM_HIT_DIVERGED_RETRY_COOLDOWN_S", "0.3")
