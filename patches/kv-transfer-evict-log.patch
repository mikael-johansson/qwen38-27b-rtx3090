+class _EvictAccumulator:
+    """Batches EVICT counts for one tier and flushes at most once per
+    _EVICT_LOG_INTERVAL_S. Individual block reclaims are request-agnostic
+    (content-addressed) and happen on essentially every reused block in
+    steady-state operation, so logging each one would reintroduce the same
+    per-iteration noise problem this module exists to avoid.
+    """
+
+    def __init__(self, tier: str):
+        self.tier = tier
+        self._blocks = 0
+        self._tokens = 0
+        self._window_start = time.monotonic()
+
+    def add(self, num_blocks: int, num_tokens: int | None = None) -> None:
+        if not _ENABLED or num_blocks <= 0:
+            return
+        self._blocks += num_blocks
+        if num_tokens:
+            self._tokens += num_tokens
+        now = time.monotonic()
+        elapsed = now - self._window_start
+        if elapsed >= _EVICT_LOG_INTERVAL_S:
+            self._flush(elapsed)
+            self._window_start = now
+
+    def _flush(self, elapsed: float) -> None:
+        if self._blocks <= 0:
+            return
+        log_kv_transfer(
+            "EVICT",
+            "-",
+            self.tier,
+            "gone",
+            self._blocks,
+            self._tokens or None,
+            note=f"reclaimed for reuse, last {elapsed:.1f}s",
+        )
+        self._blocks = 0
+        self._tokens = 0
+
+
+_vram_evict_accumulator = _EvictAccumulator("VRAM")
+_ram_evict_accumulator = _EvictAccumulator("RAM")
+
+
+def log_vram_evict(num_blocks: int, num_tokens: int | None = None) -> None:
+    """Record VRAM (GPU prefix-cache) blocks reclaimed for reuse.
+
+    Call with the count from one batch of reclaims (e.g. one
+    BlockPool.get_new_blocks() call) -- accumulation and throttling are
+    handled internally, so this is safe to call as often as reclaims
+    actually happen.
+    """
+    _vram_evict_accumulator.add(num_blocks, num_tokens)
+
+
+def log_ram_evict(num_blocks: int, num_tokens: int | None = None) -> None:
+    """Record RAM (offload primary tier) blocks reclaimed for reuse.
+
+    Call with the count from one batch of reclaims (e.g. one
+    OffloadingManager.prepare_store() call) -- accumulation and throttling
+    are handled internally.
+    """
+    _ram_evict_accumulator.add(num_blocks, num_tokens)
