+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Readable per-request arrival/completion logging.
+
+The default per-iteration logging (--enable-logging-iteration-details)
+answers "what is the engine doing right now", but at typical decode
+cadences (one engine step per few tokens under speculative decoding) it
+fires on nearly every step -- too frequent to read live. What you actually
+want while watching a server is coarser: *did this request show up with a
+warm cache, and how did it do end to end?* This module emits exactly two
+lines per request, independent of how many engine steps it took:
+
+    NEW REQUEST chatcmpl-b746f047edffef5e-9a1f8167: 83746 prompt (97.5% cached, 742 uncached tokens)
+    FINISHED    chatcmpl-b746f047edffef5e-9a1f8167: 83746 tokens prompt, PP 742 tok / 101.3 PPtok/s TTFT: 7.5s, GEN: 237 tokens (87.5 tok/s)
+
+The request id is the internal id (matches the "KV LOAD"/"KV STORE" lines
+in v1/kv_offload/transfer_log.py and the "generation [...]" lines from
+--enable-logging-iteration-details, so all four can be grepped together).
+
+Set VLLM_REQUEST_LIFECYCLE_LOG=0 to silence it. It is deliberately INFO
+and on by default: the whole point is to be visible next to the request
+log without turning on per-iteration debug logging.
+"""
+
+import os
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# Read once at import, like VLLM_KV_TRANSFER_LOG -- a deployment-level
+# switch, not something to re-check per request.
+_ENABLED = os.environ.get("VLLM_REQUEST_LIFECYCLE_LOG", "1") != "0"
+
+# Matches transfer_log.py's _REQ_ID_MAX: keep the head, which is what
+# appears in the request log filenames and the API response.
+_REQ_ID_MAX = 34
+
+
+def request_lifecycle_log_enabled() -> bool:
+    return _ENABLED
+
+
+def _short_req_id(req_id: str) -> str:
+    if len(req_id) <= _REQ_ID_MAX:
+        return req_id
+    return req_id[:_REQ_ID_MAX] + "…"
+
+
+def log_new_request(
+    req_id: str,
+    num_prompt_tokens: int,
+    num_cached_tokens: int,
+) -> None:
+    """Emit one line when a request's cache-hit outcome becomes known
+    (its first prefill chunk, not admission -- the cached fraction isn't
+    known any earlier than that)."""
+    if not _ENABLED:
+        return
+    num_uncached = num_prompt_tokens - num_cached_tokens
+    pct_cached = (
+        (num_cached_tokens / num_prompt_tokens * 100) if num_prompt_tokens else 0.0
+    )
+    logger.info(
+        "NEW REQUEST %s: %d prompt (%.1f%% cached, %d uncached tokens)",
+        _short_req_id(req_id),
+        num_prompt_tokens,
+        pct_cached,
+        num_uncached,
+    )
+
+
+def log_finished_request(
+    req_id: str,
+    num_prompt_tokens: int,
+    num_uncached_tokens: int,
+    prefill_time: float,
+    ttft: float,
+    num_generation_tokens: int,
+    decode_time: float,
+) -> None:
+    """Emit one line when a request finishes (all sampled, non-error
+    finish reasons -- errors/aborts skip this, nothing to summarize)."""
+    if not _ENABLED:
+        return
+    pp_rate = f"{num_uncached_tokens / prefill_time:.1f}" if prefill_time > 0 else "?"
+    gen_rate = (
+        f"{num_generation_tokens / decode_time:.1f}" if decode_time > 0 else "?"
+    )
+    logger.info(
+        "FINISHED %s: %d tokens prompt, PP %d tok / %s PPtok/s "
+        "TTFT: %.1fs, GEN: %d tokens (%s tok/s)",
+        _short_req_id(req_id),
+        num_prompt_tokens,
+        num_uncached_tokens,
+        pp_rate,
+        ttft,
+        num_generation_tokens,
+        gen_rate,
+    )
