+# TEMPORARY (RESTORE_CORRUPTION_PLAN3.md Phase A): the uninitialized-memory
+# (stale-block) hypothesis test. If set, every freshly-allocated GPU KV
+# cache tensor is filled with a deliberately nonzero byte pattern right
+# after allocation/registration -- before any request ever runs -- so that
+# any byte a copy/write path *fails* to touch before it's later read
+# (either by the live forward pass or, crucially, by a restored request)
+# shows up as detectable non-zero contamination instead of silently
+# reading zeros (which a virgin CUDA allocation would otherwise supply,
+# masking the very bug this test is hunting for). "1" = mild pattern
+# (0x3C, fp16 ~1.06 -- plausible-looking stale data, unlikely to trip a
+# NaN-guard some other code path might have); "ff" = aggressive pattern
+# (0xFF, NaN-heavy in every float dtype in use here) held in reserve for
+# Phase A3 if the mild pattern turns out to be numerically inert.
+# VLLM_DEBUG_SCRIBBLE_KV_ONLY restricts which KV-cache groups get
+# scribbled ("attn" or "mamba"; unset/other = all groups) for Phase B's
+# field bisection. Revert by deleting this patch; not meant to ship.
+_SCRIBBLE_KV = os.environ.get("VLLM_DEBUG_SCRIBBLE_KV")
+_SCRIBBLE_KV_ONLY = os.environ.get("VLLM_DEBUG_SCRIBBLE_KV_ONLY")
+
+
+def _scribble_kv_caches(kv_caches: dict[str, "torch.Tensor"], kv_cache_config) -> None:
+    if not _SCRIBBLE_KV:
+        return
+    # "ff" = 0xFF (NaN in fp16/fp8 -- propagates through any op it touches,
+    # so it can't cleanly separate which *field* has the unwritten region
+    # once corrupted content reaches a shared residual stream). "big" =
+    # 0x7B (fp16 61280.0, finite but huge -- perturbing without the
+    # blanket NaN-propagation confound). default/"1" = 0x3C (mild, numerically
+    # inert in this test).
+    if _SCRIBBLE_KV == "ff":
+        pattern = 0xFF
+    elif _SCRIBBLE_KV == "big":
+        pattern = 0x7B
+    else:
+        pattern = 0x3C
+
+    attn_layers: set[str] = set()
+    mamba_layers: set[str] = set()
+    for group in kv_cache_config.kv_cache_groups:
+        spec = group.kv_cache_spec
+        target = attn_layers if isinstance(spec, FullAttentionSpec) else mamba_layers
+        target.update(group.layer_names)
+
+    total_bytes = 0
+    scribbled_layers = 0
+    for layer_name, tensor in kv_caches.items():
+        if _SCRIBBLE_KV_ONLY == "attn" and layer_name not in attn_layers:
+            continue
+        if _SCRIBBLE_KV_ONLY == "mamba" and layer_name not in mamba_layers:
+            continue
+        byte_view = tensor.view(torch.uint8)
+        byte_view.fill_(pattern)
+        total_bytes += byte_view.numel()
+        scribbled_layers += 1
+        logger.info(
+            "SCRIBBLE_KV layer=%s group=%s shape=%s pattern=0x%02x bytes=%d",
+            layer_name,
+            "attn" if layer_name in attn_layers else "mamba",
+            tuple(tensor.shape),
+            pattern,
+            byte_view.numel(),
+        )
+    logger.info(
+        "SCRIBBLE_KV done: %d layers, %d bytes, pattern=0x%02x, only=%s",
+        scribbled_layers,
+        total_bytes,
+        pattern,
+        _SCRIBBLE_KV_ONLY or "all",
+    )
+
 
