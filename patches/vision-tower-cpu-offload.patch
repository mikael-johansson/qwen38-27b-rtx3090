+class _VisionPrefetchOffloader(PrefetchOffloader):
+    """PrefetchOffloader that drives its own hooks instead of the global one.
+
+    Stock ``PrefetchOffloader._hook_module_forward`` does not call itself: it
+    goes through ``torch.ops.vllm.wait_prefetch`` / ``start_prefetch``, and
+    those resolve the offloader via the *global* singleton ``get_offloader()``
+    (offloader/prefetch_ops.py). The vision tower needs a **dedicated**
+    instance, so its budget can neither be consumed by nor steal budget from
+    language-model layers -- and a dedicated instance is invisible to those
+    ops. They would hit the global ``NoopOffloader``, whose ``_wait_for_layer``
+    and ``_start_prefetch`` are ``pass``.
+
+    That failure is silent and it is not a slowdown: it is *no synchronization
+    at all*, so the compute stream reads staging buffers while the copy stream
+    is still filling them. The tower then emits plausible-looking but wrong
+    embeddings, non-deterministically. Hence: call through the instance.
+
+    Bypassing the custom ops is only safe because the ViT is neither
+    torch.compile'd nor cudagraph'd here (``compile_mm_encoder`` and
+    ``cudagraph_mm_encoder`` both default to False, and neither is enabled in
+    this deployment). Their sole purpose is to give torch.compile a data
+    dependency it cannot reorder. If those flags are ever turned on, this
+    class -- and the whole design -- must be revisited.
+    """
+
+    def prime(self) -> None:
+        """Load the first `prefetch_step` blocks before a forward pass starts.
+
+        Replaces the stock hook's wrap-around prefetch -- see the slot-aliasing
+        note in _hook_module_forward. Safe to call at the top of every forward:
+        start_onload_to_static() forks off an event recorded on the compute
+        stream, so these copies queue behind all of the previous image's work.
+        """
+        for i in range(min(self.prefetch_step, len(self.module_offloaders))):
+            self._start_prefetch(i)
+
+    def _hook_module_forward(self, index: int, module: nn.Module):
+        original_forward = module.forward
+
+        def forward(*args, **kwargs):
+            # Swap the real forward back in so the call below does not recurse.
+            module.forward = original_forward
+            try:
+                self._wait_for_layer(index)
+                output = original_forward(*args, **kwargs)
+                # Kick off the block that will land in the slot this one just
+                # freed. start_onload_to_static() forks off an event recorded
+                # on the compute stream, so the copy cannot overwrite a buffer
+                # whose reads are still enqueued.
+                #
+                # NB: stock PrefetchOffloader wraps here --
+                # `(index + prefetch_step) % len(...)` -- to pre-load the head
+                # of the stack for the next pass. That is only safe when
+                # len(modules) % prefetch_step == 0. Otherwise the wrapped
+                # prefetch targets a slot that a LATER block of this same pass
+                # still needs, and clobbers it. With this tower's 27 blocks and
+                # prefetch_step=2: block 25 prefetches block 0 into slot 0,
+                # but block 26 also uses slot 0 and its weights were staged
+                # back at block 24 -- so block 26 computes on block 0's
+                # weights. Measured: 0/10 passes bit-exact at 27/step=2, 6/6 at
+                # 27/step=3 and at 26/step=2.
+                #
+                # So: never wrap. prime() re-loads the head of the stack at the
+                # start of each forward instead, which is correct for any block
+                # count and any prefetch_step.
+                next_index = index + self.prefetch_step
+                if next_index < len(self.module_offloaders):
+                    self._start_prefetch(next_index)
+                return output
+            finally:
+                module.forward = forward
+
+        module.forward = forward
+
