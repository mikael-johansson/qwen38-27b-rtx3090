+        def _make_block(layer_idx: int) -> "Qwen3_VisionBlock":
+            return Qwen3_VisionBlock(
+                dim=self.hidden_size,
+                num_heads=self.num_heads,
+                mlp_hidden_dim=vision_config.intermediate_size,
+                act_fn=_ACTIVATION_REGISTRY[vision_config.hidden_act],
+                norm_layer=norm_layer,
+                quant_config=quant_config,
+                prefix=f"{prefix}.blocks.{layer_idx}",
+            )
+
+        # request-logging patch: optionally keep the ViT blocks' weights out of
+        # VRAM (see patches/vision-tower-cpu-offload.patch).
+        #
+        # Stock --cpu-offload-gb / --cpu-offload-params cannot reach a vision
+        # tower: the offloader's only call site in vLLM is
+        # get_offloader().wrap_modules() inside make_layers()
+        # (model_executor/models/utils.py), which builds the *language model*
+        # decoder stack. The tower's blocks are a plain nn.ModuleList, so the
+        # offloader never sees them and the flags are a silent no-op.
+        #
+        # A dedicated offloader instance is used rather than the global one so
+        # this budget cannot be consumed by (or steal budget from) language
+        # model layers: cpu_offload_params is left empty, which means "offload
+        # everything handed to me", and the only modules handed over are the
+        # ViT blocks.
+        vision_offload_gib = envs.VLLM_VISION_CPU_OFFLOAD_GB
+        if vision_offload_gib > 0:
+            from vllm.model_executor.offloader.uva import UVAOffloader
+
+            offloader = UVAOffloader(int(vision_offload_gib * (1024**3)))
+            blocks = offloader.wrap_modules(
+                _make_block(layer_idx) for layer_idx in range(vision_config.depth)
+            )
+            logger.info(
+                "Vision tower: CPU-offloading ViT blocks via UVA "
+                "(budget %.2f GiB, %d blocks). Weights live in pinned host RAM "
+                "and are read over PCIe during the forward pass; compute stays "
+                "on the GPU.",
+                vision_offload_gib,
+                len(blocks),
+            )
+        else:
+            blocks = [_make_block(layer_idx) for layer_idx in range(vision_config.depth)]
+
+        self.blocks = nn.ModuleList(blocks)
 
