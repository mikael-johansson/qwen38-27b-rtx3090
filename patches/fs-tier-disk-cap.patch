@@ -192,6 +213,130 @@ class FileSystemTierManager(SecondaryTierManager):
 
         self._lookup_manager = FsAsyncLookupManager(tier=self, tier_type=self.tier_type)
 
+        # Cap the WHOLE root_dir, not just this run's own block directory.
+        #
+        # FileMapper.base_path is "<root_dir>/<model>_<sha256-of-kv-config>", so
+        # ANY change to the KV cache group layout (layer names, tokens per block
+        # -- e.g. turning the vision tower on with VISION=1, which adds the ViT
+        # layers) mints a brand-new directory and strands the previous one.
+        # Scoping the cap to `<base_path>_r<rank>` therefore capped each config
+        # separately: effective disk usage was N_configs x max_disk_gib, and the
+        # stranded directories were never evicted at all because no running
+        # server ever pointed its cap thread at them.
+        #
+        # That filled a 234 GB NVMe on 2026-08-23: the live config sat correctly
+        # at its 201 GiB cap while a 22 GiB directory orphaned by an earlier
+        # config pushed the filesystem to 100%, and every store failed with
+        # "[Errno 28] No space left on device" while serving continued.
+        #
+        # Scanning root_dir fixes both: the cap becomes a true whole-cache
+        # budget, and orphaned blocks are simply the least-recently-accessed
+        # ones, so they are the first to be evicted. Blocks belonging to another
+        # concurrently-running config can be evicted here -- that costs that
+        # server one ordinary MISS (recompute), never a crash or torn read, the
+        # same guarantee the eviction path already relies on.
+        self._disk_cap_dir = root_dir
+        self._max_disk_bytes = (
+            int(max_disk_gib * (1024**3)) if max_disk_gib > 0 else 0
+        )
+        self._disk_cap_thread: threading.Thread | None = None
+        self._disk_cap_stop = threading.Event()
+        if self._max_disk_bytes:
+            logger.info(
+                "KV offload fs tier '%s': capping on-disk usage at %.1f GiB "
+                "(least-recently-accessed *.bin files evicted first; "
+                "checked every %.0fs in a background thread) -- %s",
+                tier_type,
+                max_disk_gib,
+                disk_cap_check_interval_s,
+                self._disk_cap_dir,
+            )
+            self._disk_cap_thread = threading.Thread(
+                target=self._disk_cap_loop,
+                args=(disk_cap_check_interval_s,),
+                name="vllm_kv_fs_disk_cap",
+                daemon=True,
+            )
+            self._disk_cap_thread.start()
+
+    def _disk_cap_loop(self, interval_s: float) -> None:
+        # Wait out the first interval before the first check so this never
+        # competes with model/server startup I/O.
+        while not self._disk_cap_stop.wait(interval_s):
+            try:
+                self._evict_for_disk_cap()
+            except Exception:
+                # Best-effort background maintenance: never let an
+                # unexpected error kill this thread and silently stop
+                # enforcing the cap for the rest of the server's life.
+                logger.exception(
+                    "KV offload fs tier: disk-cap eviction pass failed, "
+                    "will retry on the next interval"
+                )
+
+    def _evict_for_disk_cap(self) -> None:
+        """Scan this rank's block directory and delete the
+        least-recently-accessed *.bin files until usage is back at or under
+        max_disk_gib.
+
+        Runs entirely off the main scheduling thread (see _disk_cap_loop).
+        Safe to race concurrent stores/reads/promotions: a file this pass
+        decides to delete might be re-read a moment later by an unrelated
+        in-flight job, in which case that one lookup sees a plain MISS (the
+        same outcome as if the file had simply never been offloaded) and
+        falls back to recomputing that chunk -- never a crash or corrupted
+        read, since blocks are only ever removed by filename, whole, never
+        truncated or rewritten in place.
+        """
+        total = 0
+        entries: list[tuple[float, int, str]] = []  # (atime, size, path)
+        try:
+            for dirpath, _dirnames, filenames in os.walk(self._disk_cap_dir):
+                for fname in filenames:
+                    if not fname.endswith(".bin"):
+                        continue
+                    path = os.path.join(dirpath, fname)
+                    try:
+                        st = os.stat(path)
+                    except OSError:
+                        # Deleted/moved concurrently -- fine, just skip it.
+                        continue
+                    entries.append((st.st_atime, st.st_size, path))
+                    total += st.st_size
+        except OSError:
+            # Directory doesn't exist yet (nothing stored so far) or a
+            # transient error -- next interval will retry.
+            return
+
+        if total <= self._max_disk_bytes:
+            return
+
+        entries.sort(key=lambda e: e[0])  # oldest-accessed first
+        freed = 0
+        deleted = 0
+        for _atime, size, path in entries:
+            if total - freed <= self._max_disk_bytes:
+                break
+            try:
+                os.remove(path)
+            except OSError:
+                # Already gone (e.g. a concurrent eviction pass in a
+                # multi-process deployment sharing root_dir) -- fine.
+                continue
+            freed += size
+            deleted += 1
+
+        logger.warning(
+            "KV offload fs tier: disk cap exceeded (%.2f GiB > %.2f GiB) -- "
+            "evicted %d least-recently-accessed block(s), freed %.2f GiB, "
+            "now approximately %.2f GiB",
+            total / (1024**3),
+            self._max_disk_bytes / (1024**3),
+            deleted,
+            freed / (1024**3),
+            (total - freed) / (1024**3),
+        )
+
     @override
     def on_new_request(self, req_context: ReqContext) -> RequestOffloadingContext:
         return RequestOffloadingContext()
@@ -277,5 +422,8 @@ class FileSystemTierManager(SecondaryTierManager):
         Shuts down the lookup manager and the thread pool,
         clearing pending tasks and waiting for active threads to complete.
         """
+        self._disk_cap_stop.set()
+        if self._disk_cap_thread is not None:
+            self._disk_cap_thread.join(timeout=5.0)
         self._lookup_manager.shutdown()
         self._pool.shutdown(wait=True)
